{
  "files.associations": {
    "*.mdx": "mdx"
  },
  "[mdx]": {
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": false,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",
    "editor.parameterHints.enabled": false
  },
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "mdx": false,
    "plaintext": false
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": false,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",
    "editor.parameterHints.enabled": false
  },
  "[plaintext]": {
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": false,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",
    "editor.parameterHints.enabled": false
  }
}

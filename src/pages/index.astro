---
import Base from '../layouts/Base.astro';
import { GREETING, INTRO, ABOUT, LABELS, CURRENTLY, ELSEWHERE } from '../consts';
---

<Base>
  <div class="page">
    <section class="hero">
      <h1>{GREETING}</h1>
      <p class="intro">{INTRO}</p>
    </section>

    <section class="block">
      <h2 class="label">{LABELS.about}</h2>
      <div class="prose about">
        {ABOUT.map((para) => <p set:html={para} />)}
      </div>
    </section>

    <section class="block">
      <h2 class="label">{LABELS.working}</h2>
      <ul class="currently">
        {CURRENTLY.map((item) => <li set:html={item} />)}
      </ul>
    </section>

    <section class="block">
      <h2 class="label">{LABELS.elsewhere}</h2>
      <ul class="elsewhere">
        {ELSEWHERE.map(({ label, href }) => (
          <li><a href={href} rel="me noopener">{label}</a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 6rem) 0;
    max-width: var(--measure);
  }

  .intro {
    color: var(--text-muted);
    margin-block-start: 1.5rem;
  }

  .block { margin-block-start: 4rem; }

  .block > .label { margin-block-end: 1.5rem; }

  .about { color: var(--text-muted); }

  ul { list-style: none; padding: 0; margin: 0; }

  .currently {
    max-width: var(--measure);
    display: grid;
    gap: 0.875rem;
  }

  .currently li {
    position: relative;
    padding-inline-start: 1.5rem;
    color: var(--text-muted);
  }

  .currently li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-start: 0;
    width: 0.5rem;
    height: 1px;
    background: var(--accent);
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }
</style>

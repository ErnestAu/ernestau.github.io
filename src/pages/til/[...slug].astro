---
import { getCollection, render } from 'astro:content';
import Til from '../../layouts/Til.astro';

export async function getStaticPaths() {
  // Drafts are visible while developing, but never built for production.
  const entries = await getCollection('til', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// `headings` is collected from the markdown itself - it's what the
// table of contents is built from, so it can never drift out of sync.
const { Content, headings } = await render(entry);
---

<Til entry={entry} headings={headings}>
  <Content />
</Til>

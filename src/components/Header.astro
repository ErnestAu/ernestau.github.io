---
import { SITE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Normalise so '/til' and '/til/' match, and so an entry page like
// '/til/spark' still marks the 'til' nav link as current.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header>
  <div class="page bar">
    <a class="wordmark" href="/">{SITE.name}</a>

    <nav aria-label="Main">
      <ul>
        {NAV.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header {
    border-block-end: 1px solid var(--rule);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .wordmark {
    font-family: var(--font-display), var(--font-fallback);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark:hover { color: var(--accent); }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] { color: var(--text); }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }
</style>

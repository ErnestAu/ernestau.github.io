---
// Matches the article: the driver breaks work up and hands it out, the
// workers run in parallel, and the results are written to disk — NOT
// collected back at the driver.
const workers = [
  { x: 14, cx: 70, taskFrom: 200, taskTo: 66, resTo: 196 },
  { x: 184, cx: 240, taskFrom: 240, taskTo: 240, resTo: 240 },
  { x: 354, cx: 410, taskFrom: 280, taskTo: 414, resTo: 284 },
];
// The svg is labelled with aria-label rather than a <title> child:
// a <title> renders as a hover tooltip, which we don't want.
---

<figure class="diagram">
  <svg viewBox="0 0 480 325" role="img"
       aria-label="A driver node at the top hands tasks down to three worker nodes, which run in parallel and write their results to disk.">
    <defs>
      <marker id="dw-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head-task" d="M0,0 L8,4 L0,8 z" />
      </marker>
      <marker id="dw-b" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head-res" d="M0,0 L8,4 L0,8 z" />
      </marker>
    </defs>

    {workers.map((w) => (
      <>
        <line class="task" x1={w.taskFrom} y1="60" x2={w.taskTo} y2="148" />
        <line class="result" x1={w.cx} y1="196" x2={w.resTo} y2="250" />
      </>
    ))}

    <text class="lbl" x="232" y="108" text-anchor="end">task</text>
    <text class="lbl" x="250" y="230" text-anchor="start">results</text>

    <rect class="box driver" x="175" y="14" width="130" height="46" rx="8" />
    <text class="name" x="240" y="43" text-anchor="middle">driver</text>

    {workers.map((w) => (
      <>
        <rect class="box" x={w.x} y="150" width="112" height="46" rx="8" />
        <text class="name" x={w.cx} y="179" text-anchor="middle">worker</text>
      </>
    ))}

    <path class="box" d="M170,262 v38 a70,10 0 0 0 140,0 v-38 z" />
    <ellipse class="box" cx="240" cy="262" rx="70" ry="10" />
    <text class="name" x="240" y="292" text-anchor="middle">disk</text>
  </svg>
</figure>

<style>
  .diagram { margin: 0; }
  svg { width: 100%; height: auto; display: block; }

  .box { fill: var(--bg-subtle); stroke: var(--rule); stroke-width: 1.5; }
  .driver { stroke: var(--accent); }

  .name {
    fill: var(--text);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 13px;
  }

  .task { stroke: var(--accent); stroke-width: 1.5; marker-end: url(#dw-a); }
  .head-task { fill: var(--accent); }

  .result {
    stroke: var(--text-muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
    marker-end: url(#dw-b);
  }
  .head-res { fill: var(--text-muted); }

  .lbl {
    fill: var(--text-muted);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
  }
</style>

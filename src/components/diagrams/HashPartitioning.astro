---
interface Props {
  /**
   * Draw the table as Spark first reads it: cut into ~128 MB chunks by file
   * size, which ignores the join key, so matching keys scatter. Without this
   * the diagram shows the post-shuffle split by key % 200.
   */
  random?: boolean;
  /** Outline every tile holding this key, to follow it across the split. */
  highlight?: number;
  /** Caption under the diagram. */
  note?: string;
}

const { random = false, highlight, note } = Astro.props;

// Join keys as they sit in each table before the shuffle.
const fact = [
  [201, 402, 199],
  [400, 1, 203],
  [2, 399, 402],
  [200, 1, 199],
];
const dim = [
  [3, 400, 201],
  [199, 2, 200],
  [402, 1, 399],
  [203],
];

// Where each key lands. Partitions 4 to 198 are skipped with an
// ellipsis, then the last one is drawn. The random split holds the same
// keys, placed so that no partition has a matching pair.
const partitions = random
  ? [
      { id: 0, y: 0, fact: [399, 1, 203], dim: [402, 3] },
      { id: 1, y: 88, fact: [200, 402], dim: [1, 199] },
      { id: 2, y: 176, fact: [1, 199, 201], dim: [400, 203] },
      { id: 3, y: 264, fact: [402, 2], dim: [201, 399] },
      { id: 199, y: 384, fact: [400, 199], dim: [2, 200] },
    ]
  : [
      { id: 0, y: 0, fact: [400, 200], dim: [200, 400] },
      { id: 1, y: 88, fact: [201, 1, 1], dim: [1, 201] },
      { id: 2, y: 176, fact: [402, 2, 402], dim: [2, 402] },
      { id: 3, y: 264, fact: [203], dim: [3, 203] },
      { id: 199, y: 384, fact: [199, 399, 199], dim: [199, 399] },
    ];

const label = random
  ? 'Reading the tables: fact_sales and dim_customers are cut into roughly 128 MB chunks by file size, which takes no account of the join key, so matching keys scatter. Customer 1 is in partition 1, but its sales are in partitions 0 and 2.'
  : 'Rows from fact_sales and dim_customers both go through the same key % 200 function. That function is the partitioning step, deciding where each row belongs; the arrows out of it are the shuffle, physically moving the rows. Every row with the same join key lands in the same partition: 1 and 201 in partition 1, 200 and 400 in partition 0, 199 and 399 in partition 199.';

// Both diagrams can sit on one page, so each needs its own marker id.
const arrow = `hp-a-${random ? 'random' : 'hash'}`;

const TILE_W = 34;
const TILE_H = 22;
const GAP = 6;

// Both tables are drawn three tiles wide and four rows tall, stacked so
// their middle lines up with the function box.
const TABLE_RIGHT = 10 + 3 * TILE_W + 2 * GAP;
const TABLE_H = 4 * (TILE_H + GAP) - GAP;
const FACT_Y = 92;
const DIM_Y = 270;
const FACT_MID = FACT_Y + TABLE_H / 2;
const DIM_MID = DIM_Y + TABLE_H / 2;

const PART_X = 430;
const PART_H = 78;
const PART_TILE_W = 34;
---

<figure class="diagram">
  <svg viewBox="0 -30 580 494" role="img"
       aria-label={label}>
    <defs>
      <marker id={arrow} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head" d="M0,0 L8,4 L0,8 z" />
      </marker>
    </defs>

    <text class="table fact-name" x="10" y={FACT_Y - 12}>fact_sales</text>
    {fact.map((row, r) => row.map((k, c) => (
      <>
        <rect class:list={["tile fact", { hl: k === highlight }]} x={10 + c * (TILE_W + GAP)} y={FACT_Y + r * (TILE_H + GAP)}
              width={TILE_W} height={TILE_H} rx="4" />
        <text class="key fact-key" x={10 + c * (TILE_W + GAP) + TILE_W / 2} y={FACT_Y + r * (TILE_H + GAP) + 15}
              text-anchor="middle">{k}</text>
      </>
    )))}

    <text class="table" x="10" y={DIM_Y - 12}>dim_customers</text>
    {dim.map((row, r) => row.map((k, c) => (
      <>
        <rect class:list={["tile dim", { hl: k === highlight }]} x={10 + c * (TILE_W + GAP)} y={DIM_Y + r * (TILE_H + GAP)}
              width={TILE_W} height={TILE_H} rx="4" />
        <text class="key" x={10 + c * (TILE_W + GAP) + TILE_W / 2} y={DIM_Y + r * (TILE_H + GAP) + 15}
              text-anchor="middle">{k}</text>
      </>
    )))}

    {/* Mirror of the output side: each table feeds a shared trunk into the function. */}
    <path class="arrow" fill="none"
          d={`M${TABLE_RIGHT + 6},${FACT_MID} H172 M${TABLE_RIGHT + 6},${DIM_MID} H172 M172,${FACT_MID} V${DIM_MID}`} />
    <line class="arrow" marker-end={`url(#${arrow})`} x1="172" y1="234" x2="206" y2="234" />

    <rect class="box hash" x="210" y="204" width="180" height="60" rx="8" />
    <text class="fn" x="300" y={random ? 230 : 240} text-anchor="middle">{random ? 'split by size' : 'key % 200'}</text>
    {random && (
      <text class="lbl" x="300" y="250" text-anchor="middle">~128 MB per chunk</text>
    )}

    {/* Name the two steps the article separates: the box decides, the arrows move. */}
    {!random && (
      <>
        <text class="step" x="300" y="-12" text-anchor="middle">partitioning - deciding</text>
        <text class="step" x="500" y="-12" text-anchor="middle">shuffling - moving</text>
      </>
    )}
    {random && (
      <text class="step" x="300" y="-12" text-anchor="middle">reading</text>
    )}

    {/* One trunk out of the function, branching to every drawn partition. */}
    <path class="arrow" fill="none"
          d={`M390,234 H406 M406,${partitions[0].y + PART_H / 2} V${partitions.at(-1)!.y + PART_H / 2}`} />
    {partitions.map((p) => (
      <line class="arrow" marker-end={`url(#${arrow})`}
            x1="406" y1={p.y + PART_H / 2} x2="426" y2={p.y + PART_H / 2} />
    ))}

    {partitions.map((p) => (
      <>
        <rect class="box" x={PART_X} y={p.y} width="140" height={PART_H} rx="6" />
        <text class="lbl" x={PART_X + 10} y={p.y + 17}>partition {p.id}</text>
        {p.fact.map((k, c) => (
          <>
            <rect class:list={["tile fact", { hl: k === highlight }]} x={PART_X + 10 + c * (PART_TILE_W + 4)} y={p.y + 24}
                  width={PART_TILE_W} height={TILE_H} rx="4" />
            <text class="key fact-key" x={PART_X + 10 + c * (PART_TILE_W + 4) + PART_TILE_W / 2} y={p.y + 39}
                  text-anchor="middle">{k}</text>
          </>
        ))}
        {p.dim.map((k, c) => (
          <>
            <rect class:list={["tile dim", { hl: k === highlight }]} x={PART_X + 10 + c * (PART_TILE_W + 4)} y={p.y + 50}
                  width={PART_TILE_W} height={TILE_H} rx="4" />
            <text class="key" x={PART_X + 10 + c * (PART_TILE_W + 4) + PART_TILE_W / 2} y={p.y + 65}
                  text-anchor="middle">{k}</text>
          </>
        ))}
      </>
    ))}
    <text class="more" x={PART_X + 70} y="364" text-anchor="middle">...</text>
  </svg>

  {note && <figcaption class="note">{note}</figcaption>}
</figure>

<style>
  .diagram { margin-inline: 0; margin-block: 1.75em; }
  svg { width: 100%; height: auto; display: block; }

  .box { fill: var(--bg-subtle); stroke: var(--rule); stroke-width: 1.5; }
  .hash { stroke: var(--accent); }

  /* fact rows take the accent, dim rows a muted neutral, so the two
     tables stay tellable apart once they're mixed inside a partition. */
  .tile.fact { fill: var(--accent-soft); }
  .tile.dim { fill: color-mix(in srgb, var(--text-muted) 16%, var(--bg)); }

  .table, .fn, .key, .lbl, .more, .step {
    font-family: var(--font-mono), ui-monospace, monospace;
  }

  .table { fill: var(--text); font-size: 13px; font-weight: 600; }
  .fact-name { fill: var(--accent); }

  .fn { fill: var(--accent); font-size: 14px; font-weight: 600; }

  .key { fill: var(--text); font-size: 12px; }
  .fact-key { fill: var(--accent); }

  .lbl { fill: var(--text-muted); font-size: 11px; }
  .step { fill: var(--text); font-size: 11.5px; font-weight: 600; }
  .tile.hl { stroke: var(--text); stroke-width: 1.5; }
  .more { fill: var(--text-muted); font-size: 18px; font-weight: 600; }

  .arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .head { fill: var(--text-muted); }

  /* Body font rather than mono: Source Serif 4 has a real italic loaded,
     whereas the mono face would be faked by the browser. */
  .note {
    margin-block-start: 0.75rem;
    font-family: var(--font-body), Georgia, serif;
    font-style: italic;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>

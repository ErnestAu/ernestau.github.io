---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'til'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { title, description, date, draft } = entry.data;

// Only top-level sections. Deeper nesting would make the rail busy,
// which defeats the point of it.
const toc = headings.filter((h) => h.depth === 2);

const dateLabel = date
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .toLowerCase();
---

<Base title={title} description={description}>
  <article class="page">
    <header class="head">
      <p class="label">til</p>
      <h1>{title}</h1>
      {description && <p class="standfirst">{description}</p>}
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {draft && <span class="draft">draft</span>}
      </p>
    </header>

    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page" data-open="false">
        <button class="toc-tap" type="button" aria-expanded="false" aria-label="Show contents"></button>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose body">
      <slot />
    </div>

    <p class="back"><a href="/til">← all til</a></p>
  </article>
</Base>

<script>
  const nav = document.querySelector<HTMLElement>('.toc');
  const tap = nav?.querySelector<HTMLButtonElement>('.toc-tap');
  const links = new Map(
    [...(nav?.querySelectorAll<HTMLAnchorElement>('a') ?? [])].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  const heads = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];

  // --- collapsed rail: tap a tick column to reveal the labels ---
  const setOpen = (open: boolean) => {
    if (!nav || !tap) return;
    nav.dataset.open = String(open);
    tap.setAttribute('aria-expanded', String(open));
  };

  tap?.addEventListener('click', () => setOpen(nav?.dataset.open !== 'true'));

  // Jumping to a section closes it again, so it never sits over the text.
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('click', (e) => {
    if (nav && !nav.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // --- highlight whichever section is being read ---
  if (links.size && heads.length) {
    const sync = () => {
      let current = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= 120) current = h;
      }
      links.forEach((a) => a.classList.remove('active'));
      links.get(current.id)?.classList.add('active');
    };
    sync();
    document.addEventListener('scroll', sync, { passive: true });
  }
</script>

<style>
  /* The page box is 46rem but the reading measure is 34rem, so content
     left-aligned inside it lands 6rem left of the viewport centre.
     Centring each block puts the text back on the true centre line. */
  .page {
    padding-inline-start: calc(var(--gutter) + 0.75rem);
  }

  .head {
    padding-block: clamp(3rem, 8vw, 4.5rem) 0;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .head .label { margin-block-end: 1.25rem; }

  /* Reads as part of the title block, not as body copy: the body serif at a
     size between h1 and prose, muted, sitting tight under the title. The date
     below it then closes the header off. */
  .standfirst {
    margin-block-start: 0.875rem;
    font-family: var(--font-body), Georgia, serif;
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .meta {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-block-start: 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .draft {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
  }

  .body {
    margin-block-start: 2.5rem;
    margin-inline: auto;
  }

  .back {
    margin-block-start: 4rem;
    max-width: var(--measure);
    margin-inline: auto;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.8125rem;
  }

  .back a { color: var(--text-muted); text-decoration: none; }
  .back a:hover { color: var(--accent); }

  /* ---- contents ----
     Narrow screens get a column of tick marks hugging the edge: about
     12px wide, so it costs the text almost nothing. Tapping it opens a
     floating panel that sits OVER the prose rather than reflowing it,
     so reading width never changes. */
  .toc {
    position: fixed;
    inset-block-start: 50%;
    translate: 0 -50%;
    inset-inline-start: 0.3rem;
    z-index: 5;
  }

  .toc ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }

  .toc a {
    display: block;
    width: 0.75rem;
    height: 2px;
    background: var(--rule);
    border-radius: 1px;
    text-indent: -9999px;
    overflow: hidden;
    transition: background 0.15s, width 0.15s;
  }

  .toc a.active { background: var(--accent); width: 1.15rem; }

  /* one tap target covering the whole tick column */
  .toc-tap {
    position: absolute;
    inset: -0.75rem -0.6rem;
    padding: 0;
  }

  /* expanded: a panel floating over the text */
  .toc[data-open='true'] {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.6875rem;
    line-height: 1.4;
    max-height: 80vh;
    overflow-y: auto;
  }

  .toc[data-open='true'] ul { gap: 0.6rem; }

  .toc[data-open='true'] a {
    width: auto;
    height: auto;
    background: none;
    text-indent: 0;
    color: var(--text-muted);
    text-decoration: none;
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: 0.7rem;
    white-space: nowrap;
  }

  .toc[data-open='true'] a.active {
    color: var(--accent);
    border-inline-start-color: var(--accent);
  }

  .toc[data-open='true'] .toc-tap { display: none; }

  /* wide: room in the left margin, so show the labels permanently */
  @media (min-width: 75rem) {
    .page { padding-inline: var(--gutter); }

    .toc {
      inset-inline-start: calc(50vw - 30rem);
      width: 11rem;
      background: none;
      border: none;
      padding: 0;
      box-shadow: none;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 0.6875rem;
      line-height: 1.4;
    }

    .toc ul { gap: 0.6rem; }

    .toc a {
      width: auto;
      height: auto;
      background: none;
      text-indent: 0;
      color: var(--text-muted);
      text-decoration: none;
      border-inline-start: 1px solid var(--rule);
      padding-inline-start: 0.7rem;
      white-space: normal;
    }

    .toc a:hover { color: var(--text); }

    /* must reset the tick's fixed width too: `.toc a.active` from the
       collapsed rail is more specific than `.toc a` in here, so without
       this the active label keeps an 18px box and wraps one letter a line. */
    .toc a.active {
      width: auto;
      height: auto;
      color: var(--accent);
      background: none;
      border-inline-start-color: var(--accent);
    }

    .toc-tap { display: none; }
  }
</style>

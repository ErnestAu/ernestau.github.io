---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'til'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { title, description, date, draft } = entry.data;

// Only top-level sections. Deeper nesting would make the sidebar busy,
// which defeats the point of it.
const toc = headings.filter((h) => h.depth === 2);

const dateLabel = date
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .toLowerCase();
---

<Base title={title} description={description}>
  <article class="page">
    <header class="head">
      <p class="label">til</p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {draft && <span class="draft">draft</span>}
      </p>
    </header>

    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose body">
      <slot />
    </div>

    <p class="back"><a href="/til">← all til</a></p>
  </article>
</Base>

<script>
  // Highlight whichever section you're currently reading.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  const heads = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];

  if (links.size && heads.length) {
    const sync = () => {
      let current = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= 120) current = h;
      }
      links.forEach((a) => a.classList.remove('active'));
      links.get(current.id)?.classList.add('active');
    };
    sync();
    document.addEventListener('scroll', sync, { passive: true });
  }
</script>

<style>
  /* The page box is 46rem but the reading measure is 34rem, so content
     left-aligned inside it lands 6rem left of the viewport centre. Centring
     each block inside the box puts the text back on the true centre line,
     while leaving the box wide enough for something to break out later. */
  .page {
    --toc-w: 5.25rem;
    /* room for the rail, which is fixed and so out of flow */
    padding-inline-start: calc(var(--toc-w) + 1.25rem);
  }

  .head {
    padding-block: clamp(3rem, 8vw, 4.5rem) 0;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .head .label { margin-block-end: 1.25rem; }

  .meta {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-block-start: 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .draft {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
  }

  .body {
    margin-block-start: 2.5rem;
    margin-inline: auto;
  }

  .back {
    margin-block-start: 4rem;
    max-width: var(--measure);
    margin-inline: auto;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.8125rem;
  }

  .back a { color: var(--text-muted); text-decoration: none; }
  .back a:hover { color: var(--accent); }

  /* ---- table of contents ----
     A left rail at every width. Narrow screens get a slimmer version
     pinned to the edge; the article reserves space for it so the two
     never overlap. */
  .toc {
    position: fixed;
    inset-block-start: 50%;
    translate: 0 -50%;
    inset-inline-start: 0.75rem;
    width: 5.25rem;
    max-height: 76vh;
    overflow-y: auto;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.625rem;
    line-height: 1.35;
  }

  .toc ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }

  .toc a {
    color: var(--text-muted);
    text-decoration: none;
    display: block;
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: 0.5rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc a:hover { color: var(--text); }

  .toc a.active {
    color: var(--accent);
    border-inline-start-color: var(--accent);
  }

  /* phones: trim the rail further so the text keeps as much width as possible */
  @media (max-width: 30rem) {
    .page { --toc-w: 4rem; }
    .toc { width: 4rem; font-size: 0.5625rem; inset-inline-start: 0.5rem; }
  }

  /* wide: the rail moves out into the left margin beside centred text */
  @media (min-width: 75rem) {
    .page { padding-inline-start: var(--gutter); }

    .toc {
      inset-inline-start: calc(50vw - 30rem);
      width: 11rem;
      font-size: 0.6875rem;
    }

    .toc ul { gap: 0.6rem; }
    .toc a { padding-inline-start: 0.7rem; }
  }
</style>

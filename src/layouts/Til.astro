---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'til'>;
}

const { entry } = Astro.props;
const { title, description, date, draft } = entry.data;

const dateLabel = date
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .toLowerCase();
---

<Base title={title} description={description}>
  <article class="page">
    <header class="head">
      <p class="label">til</p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {draft && <span class="draft">draft</span>}
      </p>
    </header>

    <div class="prose body">
      <slot />
    </div>

    <p class="back"><a href="/til">← all til</a></p>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 8vw, 4.5rem) 0;
    max-width: var(--measure);
  }

  .head .label { margin-block-end: 1.25rem; }

  .meta {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-block-start: 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .draft {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
  }

  .body { margin-block-start: 2.5rem; }

  .back {
    margin-block-start: 4rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.8125rem;
  }

  .back a { color: var(--text-muted); text-decoration: none; }
  .back a:hover { color: var(--accent); }
</style>
